# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
SUPABASE_DB_PASSWORD=postgres

# Database (for local development with Docker)
# For Supabase local: postgresql://postgres:postgres@localhost:5432/postgres
# For hosted Supabase: Use the connection string from Settings > Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MCP_SERVER_PORT=8001
MCP_TRANSPORT=stdio  # stdio or http
ENVIRONMENT=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Security
SECRET_KEY=your-super-secret-key-for-sessions-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001